# =============================================================================
# Sala de Aula - Configuração
# =============================================================================

# Número total de alunos (os dois turmos juntos).
QUANTIDADE_ALUNOS=60

# Porta HTTP pública (acessada pelos Chromebooks).
PORTA_PUBLICA=80

# Tempo de inatividade antes do container do aluno ser desligado automaticamente.
# Formato: minutos (inteiro). Recomendado 30-60.
INATIVIDADE_MINUTOS=30

# Senha inicial padrão para TODOS os alunos (eles serão obrigados a trocar no
# primeiro login). Escolha algo simples que os alunos consigam digitar rápido,
# não tem risco pois só funciona no primeiro acesso.
SENHA_INICIAL=trocar123

# Senha do painel de administração (só professor). TROQUE ANTES DE USAR.
SENHA_ADMIN=professor_troque_essa_senha

# Limites de recursos por aluno.
LIMITE_MEMORIA=400m
LIMITE_CPU=0.5

TIMEZONE=America/Sao_Paulo

# =============================================================================
# HTTPS via Cloudflare Tunnel
# =============================================================================
# Permite acesso HTTPS sem domínio, sem roteador, sem certificado manual.
# Os Chromebooks acessam via https://xxx.trycloudflare.com com cadeado verde.
#
# Para ativar: CLOUDFLARE_TUNNEL=true
# O URL HTTPS é gerado automaticamente. Para descobrir o URL atual:
#   ./url_atual.sh
#
# Modo sem conta (padrão): URL muda a cada reinicialização.
# Com conta Cloudflare gratuita: URL fixo — veja README.md#url-fixo
CLOUDFLARE_TUNNEL=true
CLOUDFLARE_TOKEN=
